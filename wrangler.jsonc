{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys to it)
	"name": "melevi",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	// Public settings, available to the Worker at runtime. Kept here (not in the dashboard)
	// because each `wrangler deploy` replaces dashboard text variables with this file's values.
	// Only PUBLIC values belong here: the publishable key is designed to be visible and the
	// database is protected by Row-Level Security. Never put the secret/service_role key here.
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://ahhzcobkkfpqseulxftx.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_jjSf5gjuntrVxKrlIgLiJA_BEGOPXj_",
		"NEXT_PUBLIC_SITE_URL": "https://melevi.isabirov720.workers.dev"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "melevi"
		}
	],
	// No R2 incremental cache: every page is rendered per request (language cookie),
	// so there is nothing to cache. See https://opennext.js.org/cloudflare/caching
	"images": {
		// Image optimization via Cloudflare Images
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
