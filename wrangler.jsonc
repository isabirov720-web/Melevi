{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	// Must match the Worker name in the Cloudflare dashboard (Workers Builds deploys to it)
	"name": "melevi",
	"compatibility_date": "2026-10-19",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "melevi"
		}
	],
	// No R2 incremental cache: every page is rendered per request (language cookie),
	// so there is nothing to cache. See https://opennext.js.org/cloudflare/caching
	"images": {
		// Image optimization via Cloudflare Images
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	}
}
