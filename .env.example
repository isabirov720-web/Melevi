# ─── Copy to .env.local (local) or add in Vercel → Project → Settings → Environment Variables ───

# Public address of the site (used in order-request links, sitemap, social previews)
NEXT_PUBLIC_SITE_URL=https://melevi.example.com

# ── Production: Supabase (database + photo storage + owner login) ──
# Supabase → Project Settings → API. The "anon"/"publishable" key is designed to be public;
# Row-Level Security in supabase/migrations/0001_init.sql decides what it can do.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NEVER put the service_role / secret key here or in Vercel. It is only used once,
# on your own computer, by `npm run seed:supabase` (optional demo data).

# ── Local mode only (used when the Supabase variables above are empty) ──
# Owner password for /admin (min. 8 characters)
ADMIN_PASSWORD=
# Optional: 32+ random characters for signing the session cookie (auto-generated if empty)
SESSION_SECRET=
